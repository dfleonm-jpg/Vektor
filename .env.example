# ──────────────────────────────────────────────────────────────
# Vektor — Variables de entorno (copiar a .env.local y rellenar)
# ──────────────────────────────────────────────────────────────

# Supabase (PostgreSQL + Auth)
# "DATABASE_URL" usa el pooler (puerto 6543) para el runtime de la app.
# "DIRECT_URL" usa la conexión directa (puerto 5432) para migraciones Prisma.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# IA — Inferencia instantánea durante el entreno
GROQ_API_KEY="[groq-api-key]"
GROQ_MODEL="llama-3.3-70b-versatile"

# IA — Análisis profundo de mesociclos (opcional)
GEMINI_API_KEY="[gemini-api-key]"
GEMINI_MODEL="gemini-2.0-flash"
